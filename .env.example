# ── MatList environment ──────────────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit `.env` (see .gitignore).
# Every key the app reads must be listed here with a short comment.

# ── Database (required) ──
# Points at the local docker-compose Postgres by default (see docker-compose.yml).
DATABASE_URL="postgresql://matlist:matlist@localhost:5432/matlist?schema=public"

# ── App ──
# Public base URL of the app (used for links in emails / callbacks).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Auth (task 0.3 — NextAuth/Auth.js v5) ──
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Trust the deployment host header (we self-host behind our own proxy, not
# Vercel). Also set via `trustHost: true` in auth.config.ts; either is enough.
AUTH_TRUST_HOST="true"

# ── File storage (S3-compatible — material images, specsheets, Spec Book PDFs) ──
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Notifications ──
# LINE Messaging API — primary channel to reach sellers with RFQs (Phase 2).
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
# Email (Resend or SES) — RFQ + account notifications.
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@matlist.local"

# ── Payment (Phase 3.5 — Omise or 2C2P; supports Thai tax invoices) ──
PAYMENT_PUBLIC_KEY=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# Comma-separated emails allowed into the operator surface (/ops/metrics).
# Leave empty to disable the ops pages entirely.
OPS_EMAILS=""

# Google OAuth (login button appears when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Password-reset email — until an email vendor is wired (MAIL_MODE=smtp),
# reset links are printed to the server log
MAIL_MODE="log"
SMTP_URL=""
APP_URL="http://localhost:3000"
