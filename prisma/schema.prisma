// MatList Prisma schema
//
// Implements every table in docs/DATA_MODEL.md. Field names use idiomatic
// camelCase (the doc's snake_case is a spec, not literal column names — see
// its note "ปรับ syntax ตาม ORM จริงได้"). Do NOT change core relations without
// asking the user (see CLAUDE.md rule + docs/ARCHITECTURE.md decision #1).
//
// Design notes carried from DATA_MODEL:
//  - SpecItem 1─* SpecOption *─1 Material: a spec line holds many material
//    options before one is confirmed; RFQs reference the SpecItem, not a
//    material, so VE swaps keep history (see VEHistory — never deleted).
//  - SpecItem.status is DERIVED in logic (empty|options|chosen|sent|quoted),
//    not stored.
//  - RFQ privacy: sellers see project/zone/spec/qty but never the designer's
//    contact until the designer engages a Quote (enforced in the API layer).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────

enum Locale {
  th
  en
}

enum OrgType {
  designer
  seller
}

// Designer side: owner | editor | viewer.  Seller side: owner | manager |
// sales | content.  (owner is shared.)  Allowed values per side are enforced
// in lib/permissions.
enum MembershipRole {
  owner
  editor
  viewer
  manager
  sales
  content
}

enum ProjectStatus {
  active
  waiting_client
  delivered
  archived
}

enum MaterialStatus {
  draft
  published
  hidden
  suspended
}

enum RFQStatus {
  open
  quoted
  closed_won
  closed_lost
  expired
}

enum DeliveryChannel {
  line
  email
  in_app
}

enum QuoteStatus {
  submitted
  selected
  rejected
}

enum ReviewerRole {
  architect
  contractor
  designer
  owner
}

// Designer: free | pro | studio.  Seller: free | standard | premium.
enum SubscriptionPlan {
  free
  pro
  studio
  standard
  premium
}

// ── Identity & org ─────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  phone               String?
  locale              Locale    @default(th)
  // bcrypt hash — credentials auth (task 0.3). Nullable so accounts created by
  // other flows (e.g. a seller who first replies to an RFQ, Phase 2) can exist
  // before a password is set. Never returned to the client.
  passwordHash        String?
  // เลขใบประกอบวิชาชีพ (ภ.สถ.) — ใช้ verify ผู้ออกแบบจริง
  professionalLicense String?
  // เวลาที่ผู้ใช้ติ๊กยอมรับข้อกำหนด+นโยบายความเป็นส่วนตัวตอนสมัคร (PDPA 4.1)
  termsAcceptedAt     DateTime?
  createdAt           DateTime  @default(now())

  memberships     Membership[]
  notifications   Notification[]
  reviews         Review[]
  chatMessages    ChatMessage[]
  auditLogs       AuditLog[]
  projectsCreated Project[]            @relation("ProjectCreatedBy")
  rfqsCreated     RFQ[]                @relation("RFQCreatedBy")
  siteLogsCreated SiteLog[]            @relation("SiteLogCreatedBy")
  resetTokens     PasswordResetToken[]
}

// รีเซ็ตรหัสผ่าน — เก็บเฉพาะ hash ของ token (ลิงก์จริงอยู่ในอีเมลเท่านั้น)
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One model for both design offices and seller companies, split by `type`.
model Organization {
  id        String   @id @default(cuid())
  name      String
  type      OrgType
  taxId     String?
  verified  Boolean  @default(false)
  // ที่อยู่จัดส่งตัวอย่าง/คลัง หลายที่ได้
  addresses Json?
  createdAt DateTime @default(now())

  memberships           Membership[]
  projects              Project[]
  materials             Material[]
  brands                Brand[]
  rfqRecipients         RFQRecipient[]
  quotes                Quote[]
  subscriptions         Subscription[]
  invoices              Invoice[]
  auditLogs             AuditLog[]
  templates             Template[]
  materialSets          MaterialSet[]
  importMappings        ImportMapping[]
  threadsAsDesigner     ChatThread[]      @relation("DesignerThreads")
  threadsAsSeller       ChatThread[]      @relation("SellerThreads")
  // Phase 5 (inert) — engagement events + prepaid wallet
  engagementsAsDesigner EngagementEvent[] @relation("DesignerEngagements")
  engagementsAsSeller   EngagementEvent[] @relation("SellerEngagements")
  wallet                SellerWallet?

  @@index([type])
}

// Remembered column→field mapping for Excel/CSV import, keyed by a fingerprint
// of the header row, so the same sheet layout auto-maps next time (ROADMAP 1.7:
// "เก็บ mapping ที่ใช้บ่อย").
model ImportMapping {
  id          String   @id @default(cuid())
  orgId       String
  fingerprint String
  mapping     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, fingerprint])
  @@index([orgId])
}

model Membership {
  id     String         @id @default(cuid())
  userId String
  orgId  String
  role   MembershipRole

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

// ── Projects & spec schedule (Phase 1 core) ────────────────────────────

model Project {
  id           String        @id @default(cuid())
  orgId        String
  name         String
  buildingType String?
  status       ProjectStatus @default(active)
  // ผัง Material Board (ตำแหน่ง/ขนาด/ลำดับชั้นของ swatch) — เก็บต่อโปรเจกต์
  boardLayout  Json?
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  specItems SpecItem[]
  rfqs      RFQ[]
  specBooks SpecBook[]
  threads   ChatThread[]
  siteLogs  SiteLog[]

  @@index([orgId])
}

// ── 5J: บันทึกหน้างาน (site-visit companion) ───────────────────────────
// รูปถ่ายหน้างานที่ปักกับรายการวัสดุ + บันทึกปัญหา (สีผิด/ของเสียหาย/ของขาด)
model SiteLog {
  id          String   @id @default(cuid())
  projectId   String
  specItemId  String?
  // "photo" | "issue"
  kind        String
  note        String?
  // เสิร์ฟผ่าน /api/files เหมือนรูปสินค้า
  photo       String?
  createdById String?
  createdAt   DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specItem  SpecItem? @relation(fields: [specItemId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("SiteLogCreatedBy", fields: [createdById], references: [id])

  @@index([projectId, createdAt])
}

// ★ ตารางที่สำคัญที่สุด — a line in the spec schedule.
model SpecItem {
  id                  String    @id @default(cuid())
  projectId           String
  // รหัสตำแหน่ง เช่น FL-01 — แก้ได้อิสระต่อโปรเจกต์ (ห้าม hardcode มาตรฐาน)
  code                String
  zone                String?
  // ตระกูลวัสดุ; nullable ตอนยังไม่เลือกหมวด
  category            String?
  qty                 Decimal?  @db.Decimal(14, 2)
  qtyUnit             String?
  // วัสดุที่ confirm แล้ว (ตัวเลือกทั้งหมดอยู่ใน SpecOption)
  confirmedMaterialId String?
  sortOrder           Int       @default(0)
  // 5J: เช็คหน้างานว่าติดตั้งแล้ว (site-visit companion)
  installedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  confirmedMaterial Material?         @relation("ConfirmedMaterial", fields: [confirmedMaterialId], references: [id])
  options           SpecOption[]
  veHistory         VEHistory[]
  rfqs              RFQ[]
  siteLogs          SiteLog[]
  engagements       EngagementEvent[] // Phase 5 (inert)

  @@index([projectId, sortOrder])
}

model SpecOption {
  id          String   @id @default(cuid())
  specItemId  String
  materialId  String
  isConfirmed Boolean  @default(false)
  addedAt     DateTime @default(now())

  specItem SpecItem @relation(fields: [specItemId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@unique([specItemId, materialId])
  @@index([specItemId])
}

// ประวัติการปรับ VE — ห้ามลบของเดิมเมื่อ VE เก็บประวัติเสมอ
model VEHistory {
  id             String   @id @default(cuid())
  specItemId     String
  fromMaterialId String?
  toMaterialId   String?
  savedPercent   Float?
  createdAt      DateTime @default(now())

  specItem     SpecItem  @relation(fields: [specItemId], references: [id], onDelete: Cascade)
  fromMaterial Material? @relation("VEFrom", fields: [fromMaterialId], references: [id])
  toMaterial   Material? @relation("VETo", fields: [toMaterialId], references: [id])

  @@index([specItemId])
}

// ── Catalog: materials & brands (seller-owned) ─────────────────────────

model Material {
  id           String         @id @default(cuid())
  sellerOrgId  String
  brandId      String?
  nameTh       String
  nameEn       String?
  model        String?
  sku          String?
  category     String
  color        String?
  size         String?
  price        Decimal?       @db.Decimal(12, 2)
  unit         String?
  // JSON ตาม schema ของหมวด (เช่น กระเบื้อง {water_abs, r_rating, edge})
  // ฐานของ search + VE Finder
  spec         Json?
  cert         String?
  leadTime     String?
  moq          String?
  warranty     String?
  noteTh       String?
  noteEn       String?
  swatchHex    String?
  images       String[]       @default([])
  specsheetUrl String?
  catalogUrl   String?
  bimUrl       String?
  status       MaterialStatus @default(draft)
  // คิดจากความครบของ field (0-100) — ไม่ใช่การซื้ออันดับ
  completeness Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  seller        Organization      @relation(fields: [sellerOrgId], references: [id], onDelete: Cascade)
  brand         Brand?            @relation(fields: [brandId], references: [id])
  specOptions   SpecOption[]
  confirmedIn   SpecItem[]        @relation("ConfirmedMaterial")
  veFrom        VEHistory[]       @relation("VEFrom")
  veTo          VEHistory[]       @relation("VETo")
  rfqRecipients RFQRecipient[]
  reviews       Review[]
  engagements   EngagementEvent[] // Phase 5 (inert)

  @@index([category, status])
  @@index([sellerOrgId])
}

model Brand {
  id                  String  @id @default(cuid())
  sellerOrgId         String
  name                String
  logoUrl             String?
  story               String?
  // หนังสือแต่งตั้งตัวแทน
  authorizationDocUrl String?

  seller    Organization @relation(fields: [sellerOrgId], references: [id], onDelete: Cascade)
  materials Material[]

  @@index([sellerOrgId])
}

// ── RFQ engine (Phase 2 — revenue) ─────────────────────────────────────

model RFQ {
  id          String    @id @default(cuid())
  specItemId  String
  // denormalize เพื่อ query เร็ว
  projectId   String
  createdById String?
  deadline    DateTime?
  note        String?
  wantSample  Boolean   @default(false)
  status      RFQStatus @default(open)
  // สำหรับ countdown ฝั่งผู้ขาย
  slaDueAt    DateTime?
  createdAt   DateTime  @default(now())

  specItem    SpecItem          @relation(fields: [specItemId], references: [id], onDelete: Cascade)
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User?             @relation("RFQCreatedBy", fields: [createdById], references: [id])
  recipients  RFQRecipient[]
  quotes      Quote[]
  engagements EngagementEvent[] // Phase 5 (inert) — quote_request events

  @@index([status, slaDueAt])
  @@index([projectId])
}

model RFQRecipient {
  id           String          @id @default(cuid())
  rfqId        String
  sellerOrgId  String
  // ตัวเลือกที่เกี่ยวกับผู้ขายนี้
  materialId   String?
  deliveredVia DeliveryChannel @default(in_app)
  openedAt     DateTime?
  respondedAt  DateTime?

  rfq      RFQ          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  seller   Organization @relation(fields: [sellerOrgId], references: [id], onDelete: Cascade)
  material Material?    @relation(fields: [materialId], references: [id])

  @@unique([rfqId, sellerOrgId, materialId])
  @@index([sellerOrgId])
}

model Quote {
  id              String      @id @default(cuid())
  rfqId           String
  sellerOrgId     String
  pricePerUnit    Decimal     @db.Decimal(12, 2)
  projectDiscount Decimal?    @db.Decimal(12, 2)
  leadTime        String?
  paymentTerms    String?
  validUntil      DateTime?
  specsheetUrl    String?
  includeSample   Boolean     @default(false)
  status          QuoteStatus @default(submitted)
  createdAt       DateTime    @default(now())

  rfq    RFQ          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  seller Organization @relation(fields: [sellerOrgId], references: [id], onDelete: Cascade)

  // One quote per seller per RFQ — enforces the documented idempotency at the
  // DB level so concurrent submits can't create duplicates.
  @@unique([rfqId, sellerOrgId])
  @@index([rfqId])
  @@index([sellerOrgId])
}

// ── Reviews (verified purchase only) ───────────────────────────────────

model Review {
  id               String       @id @default(cuid())
  materialId       String
  userId           String
  role             ReviewerRole
  stars            Int
  bodyTh           String?
  bodyEn           String?
  // ต้อง true ถึงจะแสดง — กัน review ปลอม
  verifiedPurchase Boolean      @default(false)
  createdAt        DateTime     @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([materialId])
}

// ── Templates & material sets (Studio feature) ─────────────────────────

model Template {
  id           String  @id @default(cuid())
  // nullable = system template
  orgId        String?
  name         String
  buildingType String?
  // โครงรหัส (JSON)
  structure    Json?

  org Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model MaterialSet {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  materialIds String[] @default([])

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// ── Billing ────────────────────────────────────────────────────────────

model Subscription {
  id               String           @id @default(cuid())
  orgId            String
  plan             SubscriptionPlan @default(free)
  seats            Int              @default(1)
  currentPeriodEnd DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Invoice {
  id            String   @id @default(cuid())
  orgId         String
  amount        Decimal  @db.Decimal(12, 2)
  // ใบกำกับภาษีเต็มรูป — บังคับมี (ออฟฟิศไทยต้องเบิกได้)
  taxInvoiceUrl String?
  issuedAt      DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// ── Spec Book (versioned export) ───────────────────────────────────────

model SpecBook {
  id             String    @id @default(cuid())
  projectId      String
  version        Int
  pdfUrl         String?
  // ลิงก์แชร์สาธารณะ (nullable = ยังไม่เปิดแชร์) — เพิกถอนได้โดยตั้งกลับเป็น null
  shareToken     String?   @unique
  // ลิงก์หมดอายุอัตโนมัติ (ตั้งตอนเปิดแชร์) — 5F expiring link
  shareExpiresAt DateTime?
  // Frozen render data for this version (project + items + options + material
  // details at export time). The PDF is regenerated from this so an old version
  // stays faithful even after the schedule changes. pdfUrl stays for future S3.
  snapshot       Json?
  createdBy      String?
  createdAt      DateTime  @default(now())

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feedback ShareFeedback[]

  @@unique([projectId, version])
  @@index([projectId])
}

// ── Audit log ──────────────────────────────────────────────────────────

// บันทึกทุก mutation ที่แตะราคา/สถานะ RFQ/สเปก
model AuditLog {
  id         String   @id @default(cuid())
  orgId      String?
  userId     String?
  entityType String
  entityId   String
  action     String
  diff       Json?
  createdAt  DateTime @default(now())

  org  Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([entityType, entityId])
}

// ── Chat ───────────────────────────────────────────────────────────────

model ChatThread {
  id            String   @id @default(cuid())
  designerOrgId String
  sellerOrgId   String
  // บริบทโปรเจกต์
  projectId     String?
  createdAt     DateTime @default(now())

  designerOrg Organization  @relation("DesignerThreads", fields: [designerOrgId], references: [id], onDelete: Cascade)
  sellerOrg   Organization  @relation("SellerThreads", fields: [sellerOrgId], references: [id], onDelete: Cascade)
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages    ChatMessage[]

  @@index([designerOrgId])
  @@index([sellerOrgId])
}

model ChatMessage {
  id           String   @id @default(cuid())
  threadId     String
  senderUserId String?
  // ฝั่งที่ส่ง ณ ตอนโพสต์ (designer|seller) — เก็บไว้ตรง ๆ เพราะผู้ใช้คนเดียว
  // อาจอยู่ทั้งสอง org ของ thread ทำให้เดาย้อนหลังจาก membership ไม่ได้
  senderSide   String?
  body         String
  attachments  String[] @default([])
  createdAt    DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User?      @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([threadId])
}

// ── Analytics (Phase 4.2) ──────────────────────────────────────────────
// Persistent event log replacing the prototype's in-session metrics panel.
// Internal funnel instrumentation only — never sold per-org (iron rule #3
// governs what leaves the platform; this table powers aggregate views).

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  orgId     String?
  userId    String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([orgId])
}

// ── In-app notifications (กระดิ่งบน header) ────────────────────────────
// แถวต่อผู้ใช้ (fan-out ตอนสร้าง) — อ่านแล้ว/ยังไม่อ่านเป็นของแต่ละคน
model Notification {
  id        String    @id @default(cuid())
  userId    String
  // ประเภทเหตุการณ์ เช่น rfq_new / quote_in / quote_won / chat_new
  type      String
  // ข้อความสั้น (ประกอบ i18n ฝั่ง UI ด้วย type + payload)
  payload   Json?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ── 5F: feedback จากลูกค้า/ผู้รับเหมาบนหน้าแชร์ Spec Book ─────────────
// ผูกกับ SpecBook (ลิงก์ถูกเพิกถอน → feedback หยุดรับ แต่ประวัติคงอยู่)
model ShareFeedback {
  id         String   @id @default(cuid())
  specBookId String
  itemCode   String
  guestName  String
  // approve | comment
  kind       String
  comment    String?
  createdAt  DateTime @default(now())

  specBook SpecBook @relation(fields: [specBookId], references: [id], onDelete: Cascade)

  @@index([specBookId, itemCode])
}

// ── Phase 5 — Billable Engagement Events (FOUNDATION, inert) ─────────────
// ข้อเสนอ docs/proposals/MONETIZATION_REWORK.md — วาง schema + logic ไว้ก่อน
// แต่ "ปิดสวิตช์" ทั้งหมด:
//   • ไม่มี charge จริง (creditCost มาจาก config placeholder = 0 จน validate ราคา)
//   • sample_request / contact_request มี enum ไว้ แต่ยังไม่มี UI/ไม่เก็บ PII
//     (ที่อยู่จัดส่ง/contact) จนกว่าทนายอนุมัติ PDPA — กติกาเหล็กข้อ 5
//   • ไม่ผูกเข้ากับ flow RFQ→Quote เดิม (เพิ่มข้าง ๆ ลด risk)
// สรุป: ตารางพร้อม แต่ระบบ engagement-billing ถูก gate ด้วย ENV flag (ปิด default)

enum EngagementType {
  sample_request // 🔒 PDPA-gated (ที่อยู่จัดส่ง)
  contact_request // 🔒 PDPA-gated (เปิดเผย contact ดีไซเนอร์)
  quote_request // = RFQ เดิม
  // spec_sync ไม่อยู่ที่นี่ — เก็บเป็น AnalyticsEvent เท่านั้น (ไม่ผูก billing)
}

enum EngagementBillingStatus {
  pending
  billed
  waived
  refunded
}

enum CreditTxnType {
  topup // เติมเงินล่วงหน้า → ผูก Invoice/payment (พึ่ง Phase 3.5)
  debit // event หักเครดิต
  refund
  adjustment // แอดมินปรับมือ (มี AuditLog)
}

// สมุดบันทึก intent/billing ต่อ event — ราคาเท่ากันทุกผู้ขายใน type (กติกาข้อ 2)
model EngagementEvent {
  id            String                  @id @default(cuid())
  type          EngagementType
  designerOrgId String
  sellerOrgId   String
  specItemId    String?
  materialId    String?
  rfqId         String? // set เมื่อ type = quote_request (link RFQ เดิม)
  // billing (inert จน validate ราคา + เปิด flag)
  creditCost    Int                     @default(0)
  billingStatus EngagementBillingStatus @default(pending)
  // anti-broadcast — กันเก็บซ้ำเจ้าเดิม×ดีไซเนอร์เดิม×spec เดิม ในหน้าต่างเวลา
  dedupKey      String
  createdAt     DateTime                @default(now())

  designerOrg Organization @relation("DesignerEngagements", fields: [designerOrgId], references: [id], onDelete: Cascade)
  sellerOrg   Organization @relation("SellerEngagements", fields: [sellerOrgId], references: [id], onDelete: Cascade)
  specItem    SpecItem?    @relation(fields: [specItemId], references: [id])
  material    Material?    @relation(fields: [materialId], references: [id])
  rfq         RFQ?         @relation(fields: [rfqId], references: [id])

  @@unique([dedupKey])
  @@index([sellerOrgId, type, billingStatus])
  @@index([designerOrgId])
}

// กระเป๋าเครดิตผู้ขาย (prepaid) — inert จน Phase 3.5 (payment) พร้อม
model SellerWallet {
  id             String   @id @default(cuid())
  orgId          String   @unique
  balanceCredits Int      @default(0)
  updatedAt      DateTime @updatedAt

  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
}

model CreditTransaction {
  id           String        @id @default(cuid())
  walletId     String
  type         CreditTxnType
  amount       Int // + สำหรับ topup/refund, − สำหรับ debit
  balanceAfter Int
  engagementId String? // set เมื่อ type = debit
  invoiceId    String? // set เมื่อ type = topup
  note         String?
  createdAt    DateTime      @default(now())

  wallet SellerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}
